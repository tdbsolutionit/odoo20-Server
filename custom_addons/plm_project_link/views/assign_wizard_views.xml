<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plm_project_assign_wizard_form" model="ir.ui.view">
        <field name="name">plm.project.assign.wizard.form</field>
        <field name="model">plm.project.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Gán tài liệu / Part vào dự án">
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="plm_folder"/>
                    <field name="document_ids" widget="many2many_tags" domain="[('is_plm', '=', True)]"/>
                    <field name="part_ids" widget="many2many_tags" domain="[('engineering_code', '!=', False)]"/>
                    <field name="include_children"/>
                    <field name="doc_count"/>
                    <field name="part_count"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Gán" class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_plm_project_assign_wizard" model="ir.actions.act_window">
        <field name="name">Gán tài liệu / Part</field>
        <field name="res_model">plm.project.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
