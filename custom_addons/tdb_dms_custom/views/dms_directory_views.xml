<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa Form view dms.directory để thêm phân quyền phòng ban, cờ Thùng Rác và nút Tạo thư mục con -->
    <record id="view_dms_directory_form_inherit_tdb" model="ir.ui.view">
        <field name="name">dms.directory.form.inherit.tdb</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_create_subfolder_wizard"
                    type="object"
                    string="Tạo thư mục con"
                    class="btn-primary"
                    invisible="is_recycle_bin"
                />
            </xpath>
            <xpath expr="//group[@name='settings']" position="before">
                <group name="department_security" string="Phân quyền phòng ban &amp; Quản trị">
                    <group>
                        <field name="can_manage_directory" invisible="1" />
                        <field name="available_leader_ids" invisible="1" />
                        <field name="is_sharing" widget="boolean_toggle" groups="base.group_system" help="Bật cờ này để mọi nhân viên nội bộ đều được xem phòng ban này." />
                        <field name="default_allow_download" widget="boolean_toggle" readonly="not can_manage_directory" />
                        <field name="is_recycle_bin" widget="boolean_toggle" groups="base.group_system" readonly="1" invisible="not is_recycle_bin" />
                    </group>
                    <group>
                        <field name="leader_ids" widget="many2many_tags" domain="[('id', 'in', available_leader_ids)]" options="{'color_field': 'color', 'no_create_edit': True}" groups="base.group_system,dms.group_dms_manager" placeholder="Chọn Trưởng phòng / Người quản lý thư mục..." />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa List view dms.directory để hiển thị phân quyền và nút Tạo thư mục con -->
    <record id="view_dms_directory_tree_inherit_tdb" model="ir.ui.view">
        <field name="name">dms.directory.list.inherit.tdb</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="can_manage_directory" column_invisible="True" />
                <field name="is_sharing" widget="boolean_toggle" optional="show" string="Dùng chung (Sharing)" />
                <field name="leader_ids" widget="many2many_tags" optional="show" string="Trưởng phòng / Quản lý" />
                <field name="default_allow_download" widget="boolean_toggle" readonly="not can_manage_directory" optional="show" />
                <field name="is_recycle_bin" column_invisible="True" />
                <button
                    name="action_open_create_subfolder_wizard"
                    type="object"
                    string="Tạo thư mục con"
                    title="Tạo thư mục con bên trong thư mục này"
                    invisible="is_recycle_bin"
                />
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Kanban view dms.directory để thêm mục Tạo thư mục con trong menu 3 chấm -->
    <record id="view_dms_directory_kanban_inherit_tdb" model="ir.ui.view">
        <field name="name">dms.directory.kanban.inherit.tdb</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_recycle_bin" />
                <field name="is_sharing" />
                <field name="leader_ids" />
            </xpath>
            <xpath expr="//div[@name='card_menu_view']" position="inside">
                <div role="menuitem" t-if="!record.is_recycle_bin?.raw_value">
                    <a name="action_open_create_subfolder_wizard" type="object" class="text-primary">
                        <i class="fa fa-folder-open-o" />
                        Tạo thư mục con
                    </a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
