<record id="view_reject_wizard" model="ir.ui.view">
  <field name="name">tdb.plm.reject.wizard.form</field><field name="model">tdb.plm.reject.wizard</field>
  <field name="arch" type="xml"><form string="Reject / Assign Redo"><group>
    <field name="target_model" invisible="1"/><field name="target_id" invisible="1"/>
    <field name="reason"/><field name="assignee_id" options="{'no_create': True}"/>
  </group><footer><button name="action_reject" type="object" string="Reject and Assign Redo" class="btn-primary"/>
  <button special="cancel" string="Cancel"/></footer></form></field>
</record>
<record id="view_task_wizard" model="ir.ui.view">
  <field name="name">tdb.plm.task.wizard.form</field><field name="model">tdb.plm.task.wizard</field>
  <field name="arch" type="xml"><form string="Review / Redo Assignment"><group>
    <field name="target_model" invisible="1"/><field name="target_id" invisible="1"/>
    <field name="target_ids" invisible="1"/>
    <field name="operation" readonly="1"/><field name="allowed_user_ids" invisible="1"/>
    <field name="requester_id" invisible="operation != 'recover'"
      required="operation == 'recover'" options="{'no_create': True}"/>
    <field name="user_id" domain="[('id', 'in', allowed_user_ids)]" options="{'no_create': True}"/>
    <field name="reason" invisible="operation == 'submit'" required="operation not in ['submit', 'forward', 'approve_forward']"/>
    <field name="date_deadline"/>
  </group><footer><button name="action_apply" type="object" string="Assign" class="btn-primary" invisible="operation in ['submit', 'approve_forward', 'reject']"/>
  <button name="action_apply" type="object" string="Reject and Assign Redo" class="btn-primary" invisible="operation != 'reject'"/>
  <button name="action_apply" type="object" string="Submit Review" class="btn-primary" invisible="operation != 'submit'"/>
  <button name="action_apply" type="object" string="Approve and Submit" class="btn-primary" invisible="operation != 'approve_forward'"/>
  <button special="cancel" string="Cancel"/></footer></form></field>
</record></odoo>
