<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workflow_activity_form" model="ir.ui.view">
        <field name="name">tdb.plm.workflow.activity</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group invisible="not tdb_plm_kind">
                    <field name="tdb_plm_kind"/>
                    <button name="action_tdb_open_workflow" type="object" string="Open Review / Redo" class="btn-primary"/>
                </group>
            </xpath>
        </field>
    </record>
    <!-- Include managed workflow tasks without giving them ECR/ECO semantics. -->
    <record id="activity_validation.plm_action_view_activities" model="ir.actions.act_window">
        <field name="domain">['&amp;', '|', ('activity_type_id.change_activity_type', '!=', False), ('tdb_plm_kind', '!=', False), ('active', 'in', (True, False))]</field>
        <field name="context">{'search_default_tdb_my_plm_activities': 1}</field>
        <field name="search_view_id" ref="activity_validation.plm_activity_search"/>
    </record>
    <record id="workflow_activity_list" model="ir.ui.view">
        <field name="name">tdb.plm.workflow.activity.list</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='summary']" position="after">
                <field name="tdb_plm_kind" optional="show"/>
                <field name="plm_state" optional="show"/>
            </xpath>
            <xpath expr="//list/button[@name='action_done']" position="attributes">
                <attribute name="invisible">not active or tdb_plm_kind</attribute>
            </xpath>
        </field>
    </record>
    <record id="workflow_activity_search" model="ir.ui.view">
        <field name="name">tdb.plm.workflow.activity.search</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="activity_validation.plm_activity_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="tdb_my_plm_activities" string="My PLM Activities"
                        domain="[('user_id', '=', uid), ('active', '=', True)]"/>
                <separator/>
                <filter name="tdb_plm_completed" string="Completed"
                        domain="[('plm_state', '=', 'done')]"/>
                <separator/>
                <filter name="tdb_plm_late" string="Late"
                        domain="[('date_deadline', '&lt;', 'today')]"/>
                <filter name="tdb_plm_today" string="Today"
                        domain="[('date_deadline', '=', 'today')]"/>
                <filter name="tdb_plm_future" string="Future"
                        domain="[('date_deadline', '&gt;', 'today')]"/>
                <separator/>
                <filter name="tdb_workflow" string="Review / Redo" domain="[('tdb_plm_kind', '!=', False)]"/>
            </xpath>
        </field>
    </record>
    <record id="workflow_activity_navigation" model="ir.ui.view">
        <field name="name">tdb.plm.activities.open.related.record</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="action">action_tdb_open_activity_record</attribute>
                <attribute name="type">object</attribute>
                <attribute name="default_order">active desc, date_deadline, id</attribute>
            </xpath>
            <xpath expr="//list/field[@name='user_id' and not(@widget)]" position="replace"/>
            <xpath expr="//list/field[@name='res_name']" position="attributes">
                <attribute name="string">Part / Document</attribute>
            </xpath>
            <xpath expr="//list/field[@name='role_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//list/field[@name='plm_state']" position="attributes">
                <attribute name="string">Task Status</attribute>
            </xpath>
            <xpath expr="//list/field[@name='tdb_plm_kind']" position="replace"/>
            <xpath expr="//list/field[@name='activity_type_id']" position="attributes">
                <attribute name="string">Activity Type</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
    <record id="workflow_activity_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="workflow_activity_navigation"/>
        <field name="act_window_id" ref="activity_validation.plm_action_view_activities"/>
    </record>
</odoo>
