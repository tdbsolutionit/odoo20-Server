<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="eco_affected_revisions_form" model="ir.ui.view">
        <field name="name">tdb.plm.eco.affected.revisions</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="activity_validation.mail_activity_view_form_popup_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_to_done']" position="before">
                <field name="tdb_can_finish_eco_activity" invisible="1"/>
                <field name="tdb_can_cancel_plm_activity" invisible="1"/>
                <field name="tdb_can_manage_plm_activity" invisible="1"/>
                <field name="tdb_can_start_plm_activity" invisible="1"/>
                <field name="tdb_can_edit_plm_activity" invisible="1"/>
            </xpath>
            <xpath expr="(//button[@name='action_in_progress'])[1]" position="attributes">
                <attribute name="invisible" add="not tdb_can_start_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='action_in_progress'])[2]" position="attributes">
                <attribute name="invisible" add="not tdb_can_start_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_to_eco']" position="attributes">
                <attribute name="invisible" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_to_draft']" position="attributes">
                <attribute name="invisible" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_to_exception']" position="attributes">
                <attribute name="invisible" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//div[@name='activity_details']//field[@name='summary']" position="attributes">
                <attribute name="readonly" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//div[@name='activity_details']//field[@name='date_deadline']" position="attributes">
                <attribute name="readonly" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//div[@name='activity_details']//field[@name='user_id']" position="attributes">
                <attribute name="readonly" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//div[@name='activity_details']//field[@name='role_id']" position="attributes">
                <attribute name="readonly" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//div[@name='activity_details']//field[@name='note']" position="attributes">
                <attribute name="readonly" add="not tdb_can_edit_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="(//field[@name='activity_type_id'])[1]" position="attributes">
                <attribute name="readonly" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='children_ids']" position="attributes">
                <attribute name="readonly" add="not tdb_can_manage_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_to_cancel']" position="attributes">
                <attribute name="invisible" add="not tdb_can_cancel_plm_activity" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_to_done']" position="attributes">
                <attribute name="invisible" add="not tdb_can_finish_eco_activity" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']" position="attributes">
                <attribute name="readonly">not active or plm_state != 'eco' or not tdb_can_manage_plm_activity</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list" position="inside">
                <control>
                    <create string="Add a line"/>
                    <delete invisible="not active"/>
                </control>
                <field name="active" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list/field[@name='summary']" position="attributes">
                <attribute name="readonly">not active</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list/field[@name='date_deadline']" position="attributes">
                <attribute name="readonly">not active</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list/field[@name='user_id']" position="attributes">
                <attribute name="readonly">not active</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list/field[@name='res_name']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list/field[@name='res_model']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list/field[@name='activity_type_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']/list/field[@name='res_model_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='eco_child_ids']" position="after">
                <field name="tdb_is_eco_order" invisible="1"/>
                <field name="active" invisible="1"/>
                <div class="w-100 mw-100 mt-3" invisible="not tdb_is_eco_order">
                    <separator string="Affected Revisions"/>
                    <field name="tdb_eco_revision_ids" class="w-100 d-block" nolabel="1"
                           readonly="not active or plm_state in ['done', 'cancel'] or not tdb_can_manage_plm_activity">
                        <list editable="bottom">
                            <field name="kind"/>
                            <field name="original_part_id" invisible="kind != 'part'" required="kind == 'part'"
                                   options="{'no_create': True}" domain="[('engineering_code', '!=', False)]"/>
                            <field name="original_document_id" invisible="kind != 'document'" required="kind == 'document'"
                                   options="{'no_create': True}" domain="[('is_plm', '=', True)]"/>
                            <field name="original_revision" string="Original Rev."/>
                            <field name="original_code" column_invisible="True"/>
                            <field name="replacement_part_id" invisible="kind != 'part'"
                                   options="{'no_create': True}" domain="[('engineering_code', '=', original_code), ('engineering_revision', '&gt;', original_revision)]"/>
                            <field name="replacement_document_id" invisible="kind != 'document'"
                                   options="{'no_create': True}" domain="[('is_plm', '=', True), ('engineering_code', '=', original_code), ('engineering_revision', '&gt;', original_revision)]"/>
                            <field name="replacement_revision" string="New Rev."/>
                            <field name="replacement_status" string="New Status"/>
                            <field name="release_required"/>
                        </list>
                    </field>
                </div>
            </xpath>
        </field>
    </record>
    <record id="ecr_activity_assignees_form" model="ir.ui.view">
        <field name="name">tdb.plm.ecr.activity.assignees</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="activity_validation.mail_activity_view_form_popup_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='children_ids']/list/field[@name='user_id']" position="attributes">
                <attribute name="string">Planned Assignee</attribute>
            </xpath>
            <xpath expr="//field[@name='children_ids']/list/field[@name='activity_user_id']" position="attributes">
                <attribute name="string">Actual Assignee</attribute>
            </xpath>
        </field>
    </record>
    <record id="ecr_activity_schedule_assignee" model="ir.ui.view">
        <field name="name">tdb.plm.ecr.schedule.assignee</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="activity_validation.plm_mail_activity_schedule_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_schedule_activities_done']" position="attributes">
                <attribute name="invisible" add="change_activity_type == 'request'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='children_ids']/list/field[@name='user_id']" position="attributes">
                <attribute name="string">Planned Assignee</attribute>
            </xpath>
            <xpath expr="//field[@name='children_ids']/list/field[@name='activity_user_id']" position="replace"/>
        </field>
    </record>
</odoo>
