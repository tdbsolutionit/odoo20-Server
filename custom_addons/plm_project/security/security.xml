<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_plm_project_user" model="res.groups">
        <field name="name">PLM Project / Thành viên</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_plm_project_manager" model="res.groups">
        <field name="name">PLM Project / Quản lý dự án</field>
        <field name="implied_ids" eval="[(4, ref('group_plm_project_user')), (4, ref('project.group_project_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
