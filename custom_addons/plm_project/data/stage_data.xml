<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="stage_plm_init" model="project.project.stage">
        <field name="name">Khởi tạo / Khảo sát</field>
        <field name="sequence">10</field>
    </record>
    <record id="stage_plm_design" model="project.project.stage">
        <field name="name">Thiết kế</field>
        <field name="sequence">20</field>
    </record>
    <record id="stage_plm_prototype" model="project.project.stage">
        <field name="name">Thử nghiệm mẫu</field>
        <field name="sequence">30</field>
    </record>
    <record id="stage_plm_production" model="project.project.stage">
        <field name="name">Sản xuất thử / hàng loạt</field>
        <field name="sequence">40</field>
    </record>
    <record id="stage_plm_done" model="project.project.stage">
        <field name="name">Bàn giao / Đóng dự án</field>
        <field name="sequence">50</field>
        <field name="fold" eval="True"/>
    </record>
</odoo>
