<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================= -->
    <!-- TDB SOLUTION - PHÂN TẦNG LAYER 5: VIEWS VÀ GIAO DIỆN BACKEND PLM       -->
    <!-- Kế thừa giao diện danh sách & Form Engineering Parts                   -->
    <!-- Chuỗi gốc tiếng Anh chuẩn quốc tế - Hỗ trợ đa ngôn ngữ Anh / Việt     -->
    <!-- ======================================================================= -->

    <!-- 1. Danh sách linh kiện kỹ thuật (Tree / List View) -->
    <record id="plm_component_base_tree_inherit_tdb" model="ir.ui.view">
        <field name="name">product.product.tree.plm.tdb.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="plm.plm_component_base_tree"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <!-- Thêm class nhận diện riêng cho bảng danh sách linh kiện PLM -->
            <xpath expr="//list" position="attributes">
                <attribute name="class">tdb_plm_list_view</attribute>
                <attribute name="string">Engineering Parts</attribute>
            </xpath>

            <!-- Cột 1: Hình ảnh -->
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="string">Image</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">65</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- Cột 2: Tên linh kiện -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Name</attribute>
                <attribute name="width">180</attribute>
            </xpath>

            <!-- Cột Cấu hình: Ẩn mặc định, hiển thị khi người dùng cần -->
            <xpath expr="//field[@name='configuration_name']" position="attributes">
                <attribute name="string">Configuration Name</attribute>
                <attribute name="optional">hide</attribute>
                <attribute name="width">120</attribute>
            </xpath>

            <!-- Cột 3: Mã kỹ thuật -->
            <xpath expr="//field[@name='engineering_code']" position="attributes">
                <attribute name="string">Engineering Code</attribute>
                <attribute name="width">110</attribute>
            </xpath>

            <!-- Cột 4: Mã nội bộ -->
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Internal Reference</attribute>
                <attribute name="width">120</attribute>
            </xpath>

            <!-- Cột 5: Engineering Revision -->
            <xpath expr="//field[@name='engineering_revision']" position="attributes">
                <attribute name="string">Revision</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">70</attribute>
            </xpath>

            <!-- Cột 6: Engineering Status -->
            <xpath expr="//field[@name='engineering_state']" position="attributes">
                <attribute name="string">Engineering Status</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">115</attribute>
            </xpath>

            <!-- Cột 7: Description -->
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="string">Description</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="width">120</attribute>
            </xpath>

            <!-- Cột 8: Writable -->
            <xpath expr="//field[@name='engineering_writable']" position="attributes">
                <attribute name="string">Writable</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">115</attribute>
            </xpath>

            <!-- Cột 9: CAD Raw Material -->
            <xpath expr="//field[@name='engineering_material']" position="attributes">
                <attribute name="string">CAD Raw Material</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="width">115</attribute>
            </xpath>

            <!-- Cột 10: CAD Surface Finishing -->
            <xpath expr="//field[@name='engineering_surface']" position="attributes">
                <attribute name="string">CAD Surface Finishing</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="width">115</attribute>
            </xpath>

            <!-- Cột 11: Linked Documents -->
            <xpath expr="//field[@name='linkeddocuments']" position="attributes">
                <attribute name="string">Linked Documents</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="widget">many2many_tags</attribute>
                <attribute name="width">125</attribute>
            </xpath>

            <!-- Cột 12: Checked-Out By -->
            <xpath expr="//field[@name='document_checkout_user_ids']" position="attributes">
                <attribute name="string">Checked-Out By</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="widget">many2many_tags</attribute>
                <attribute name="width">135</attribute>
            </xpath>
        </field>
    </record>

    <!-- 2. Giao diện tìm kiếm PLM Component Search (Filters & Group By) -->
    <record id="plm_component_base_search_inherit_tdb" model="ir.ui.view">
        <field name="name">product.product.search.plm.tdb.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="plm.plm_component_base_search"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='latest']" position="attributes">
                <attribute name="string">Latest</attribute>
            </xpath>
            <xpath expr="//filter[@name='checked_out']" position="attributes">
                <attribute name="string">Checked Out</attribute>
            </xpath>
            <xpath expr="//filter[@name='string']" position="attributes">
                <attribute name="string">Confirmed</attribute>
            </xpath>
            <xpath expr="//filter[@name='released']" position="attributes">
                <attribute name="string">Released</attribute>
            </xpath>
            <xpath expr="//filter[@name='obsolated']" position="attributes">
                <attribute name="string">Obsoleted</attribute>
            </xpath>
        </field>
    </record>

    <!-- 3. Giao diện Form linh kiện PLM (plm_component_base_form) -->
    <record id="plm_component_base_form_inherit_tdb" model="ir.ui.view">
        <field name="name">product.product.form.plm.tdb.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="plm.plm_component_base_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_release']" position="attributes">
                <attribute name="string">Release Component</attribute>
            </xpath>
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="string">Correct Component</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="string">Confirm Component</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="engineering_state" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Description</attribute>
                <attribute name="readonly">engineering_state in ['released', 'obsoleted']</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_code']" position="attributes">
                <attribute name="string">Engineering Code</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_revision']" position="attributes">
                <attribute name="string">Revision</attribute>
            </xpath>
            <xpath expr="//field[@name='std_description']" position="attributes">
                <attribute name="string">Standard Description</attribute>
            </xpath>
            <xpath expr="//group[@name='std_desc_attrs']" position="attributes">
                <attribute name="string">Standard Description Parameters</attribute>
            </xpath>
            <xpath expr="//page[@name='technical_infos']" position="attributes">
                <attribute name="string">Technical Information</attribute>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="string">Category</attribute>
                <attribute name="readonly">engineering_state in ['released', 'obsoleted']</attribute>
            </xpath>
            <xpath expr="//group[@name='technical_infos_group']" position="attributes">
                <attribute name="string">Material / Surface / Treatment</attribute>
            </xpath>
            <xpath expr="//group[@name='workflow_section']" position="attributes">
                <attribute name="string">Workflow</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_release_user']" position="attributes">
                <attribute name="string">Released By</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_release_date']" position="attributes">
                <attribute name="string">Release Date</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_revision_user']" position="attributes">
                <attribute name="string">Revision By</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_revision_date']" position="attributes">
                <attribute name="string">Revision Date</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_workflow_user']" position="attributes">
                <attribute name="string">Workflow User</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_workflow_date']" position="attributes">
                <attribute name="string">Workflow Date</attribute>
            </xpath>
        </field>
    </record>

    <!-- 4. Giao diện Form sản phẩm chuẩn mở rộng PLM (plm_product_product_normal_form_view_inherit) -->
    <record id="plm_product_product_normal_form_view_inherit_tdb" model="ir.ui.view">
        <field name="name">product.product.normal.form.plm.tdb.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="plm.plm_product_product_normal_form_view_inherit"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_release']" position="attributes">
                <attribute name="string">Release Component</attribute>
            </xpath>
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="string">Correct Component</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="string">Confirm Component</attribute>
            </xpath>
            <xpath expr="//button[@name='open_related_revisions']" position="attributes">
                <attribute name="string">Revision</attribute>
            </xpath>
            <xpath expr="//button[@name='open_template']" position="attributes">
                <attribute name="string">Template</attribute>
            </xpath>
            <xpath expr="//button[@name='action_print_bom_report']" position="attributes">
                <attribute name="string">Print BoM</attribute>
            </xpath>
            <xpath expr="//field[@name='engineering_code']/ancestor::group[1]" position="attributes">
                <attribute name="string">OdooPLM Information</attribute>
            </xpath>
        </field>
    </record>

    <!-- 5. Tiêu đề Action cửa sổ phân hệ PLM -->
    <record id="plm.action_plm_component_base" model="ir.actions.act_window">
        <field name="name">Engineering Parts</field>
    </record>

    <record id="plm.action_plm_component_base_cad_form" model="ir.actions.act_window">
        <field name="name">Engineering Parts</field>
    </record>
</odoo>
