<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Wizard: Liên kết Bản vẽ 2D với Mô hình 3D -->
    <record id="view_plm_link_drawing_wizard_form" model="ir.ui.view">
        <field name="name">plm.link.drawing.wizard.form</field>
        <field name="model">plm.link.drawing.wizard</field>
        <field name="arch" type="xml">
            <form string="Liên kết Bản vẽ 2D (Layout Tree)">
                <div class="alert alert-info d-flex align-items-center mb-3 py-2" role="alert">
                    <span>Chọn tệp bản vẽ 2D (.slddrw, .dwg, .dxf, .pdf) để liên kết quan hệ 2D-3D với mô hình này.</span>
                </div>
                <group>
                    <group string="Mô hình 3D đích">
                        <field name="parent_name" string="Tên mô hình 3D"/>
                    </group>
                    <group string="Bản vẽ 2D cần liên kết">
                        <field name="drawing_id"
                               string="Bản vẽ 2D"
                               options="{'no_create': True, 'no_create_edit': True}"
                               placeholder="Tìm hoặc chọn file bản vẽ 2D..."/>
                        <field name="drawing_code" string="Mã kỹ thuật" invisible="not drawing_id"/>
                        <field name="drawing_state" string="Trạng thái bản vẽ" invisible="not drawing_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_link"
                            type="object"
                            string="Xác nhận liên kết"
                            class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Form View Wizard: Tải lên Bản in PDF Kỹ thuật -->
    <record id="view_plm_upload_printout_wizard_form" model="ir.ui.view">
        <field name="name">plm.upload.printout.wizard.form</field>
        <field name="model">plm.upload.printout.wizard</field>
        <field name="arch" type="xml">
            <form string="Tải lên Bản in PDF Kỹ thuật">
                <field name="attachment_id" invisible="1"/>
                <div class="alert alert-info d-flex align-items-center mb-3 py-2" role="alert">
                    <span>Tải lên tệp bản vẽ in PDF kỹ thuật cho tài liệu. Hệ thống sẽ lưu vào dữ liệu Printout để xem trước và tải về.</span>
                </div>
                <group>
                    <group string="Tài liệu nhận file">
                        <field name="attachment_name" string="Tên tài liệu"/>
                        <field name="engineering_code" string="Mã kỹ thuật"/>
                    </group>
                    <group string="Tệp PDF kỹ thuật">
                        <field name="pdf_file"
                               widget="binary"
                               filename="pdf_filename"
                               options="{'accepted_file_extensions': '.pdf'}"
                               string="Chọn tệp PDF"
                               required="1"/>
                        <field name="pdf_filename"
                               string="Tên tệp lưu trữ"
                               required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_upload"
                            type="object"
                            string="Tải lên &amp; Lưu"
                            class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
